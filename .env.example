# npm run dev uses defaults; npm start loads .env if present.
PORT=3001
HOST=127.0.0.1
DATA_DIR=./data
# Set when deploying. Must be exactly the browser origin (no path).
# PUBLIC_ORIGIN=https://your-domain.example
# NODE_ENV=production
# COOKIE_SECURE=true
# TRUST_PROXY=1
MAX_USER_STORAGE_MB=500
# Set false to disable new account registration.
ALLOW_REGISTRATION=true
